<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>A365.OpenTelemetry.Exporter</PackageId>
    <Version>0.1.0</Version>
    <Authors>Agent 365 Observability Team</Authors>
    <Description>OpenTelemetry SpanExporter for Agent 365 Observability. Exports spans to the A365 ingestion endpoint grouped by tenant and agent.</Description>
    <PackageTags>opentelemetry;agent365;observability;exporter;tracing</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
    <PackageReference Include="OpenTelemetry" Version="1.7.0" />
    <PackageReference Include="System.Net.Http.Json" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.4" />
  </ItemGroup>

</Project>
