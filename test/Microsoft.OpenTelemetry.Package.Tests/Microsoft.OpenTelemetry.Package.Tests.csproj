<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Microsoft.OpenTelemetry.Package.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <MicrosoftOpenTelemetryPackageVersion>1.2.0-validation</MicrosoftOpenTelemetryPackageVersion>
    <Agent365EtwSdkPackageVersion>1.2.0-validation</Agent365EtwSdkPackageVersion>
    <PackageValidationArtifactsPath>$(BaseIntermediateOutputPath)package-validation\$(Configuration)\</PackageValidationArtifactsPath>
    <DistroPackageSourcePath>$(PackageValidationArtifactsPath)distro-source\</DistroPackageSourcePath>
    <EtwPackageSourcePath>$(PackageValidationArtifactsPath)etw-source\</EtwPackageSourcePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <PropertyGroup>
    <ContractsProjectPath>$(MSBuildProjectDirectory)\..\..\src\Microsoft.Agents.A365.Observability.Contracts\Microsoft.Agents.A365.Observability.Contracts.csproj</ContractsProjectPath>
    <EtwProjectPath>$(MSBuildProjectDirectory)\..\..\src\Microsoft.Agents.A365.Observability.Etw\Microsoft.Agents.A365.Observability.Etw.csproj</EtwProjectPath>
    <DistroProjectPath>$(MSBuildProjectDirectory)\..\..\src\Microsoft.OpenTelemetry\Microsoft.OpenTelemetry.csproj</DistroProjectPath>
  </PropertyGroup>

  <Target Name="PreparePackageValidationArtifacts" BeforeTargets="VSTest">
    <RemoveDir Directories="$(PackageValidationArtifactsPath)" />
    <MakeDir Directories="$(PackageValidationArtifactsPath)" />

    <MSBuild
      Projects="$(ContractsProjectPath);$(EtwProjectPath);$(DistroProjectPath)"
      Targets="Restore"
      BuildInParallel="false"
      RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained"
      Properties="Configuration=$(Configuration);NoBuild=false;MicrosoftOpenTelemetryPackageVersion=$(MicrosoftOpenTelemetryPackageVersion);Agent365EtwSdkPackageVersion=$(Agent365EtwSdkPackageVersion)" />
    <MSBuild
      Projects="$(ContractsProjectPath);$(EtwProjectPath);$(DistroProjectPath)"
      Targets="Build"
      BuildInParallel="false"
      RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained"
      Properties="Configuration=$(Configuration);NoBuild=false;MicrosoftOpenTelemetryPackageVersion=$(MicrosoftOpenTelemetryPackageVersion);Agent365EtwSdkPackageVersion=$(Agent365EtwSdkPackageVersion)" />
    <MSBuild
      Projects="$(ContractsProjectPath);$(EtwProjectPath);$(DistroProjectPath)"
      Targets="Pack"
      BuildInParallel="false"
      RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained"
      Properties="Configuration=$(Configuration);NoBuild=true;PackageOutputPath=$(PackageValidationArtifactsPath);MicrosoftOpenTelemetryPackageVersion=$(MicrosoftOpenTelemetryPackageVersion);Agent365EtwSdkPackageVersion=$(Agent365EtwSdkPackageVersion)" />

    <MakeDir Directories="$(DistroPackageSourcePath);$(EtwPackageSourcePath)" />
    <Copy
      SourceFiles="$(PackageValidationArtifactsPath)Microsoft.OpenTelemetry.$(MicrosoftOpenTelemetryPackageVersion).nupkg;$(PackageValidationArtifactsPath)Microsoft.Agents.A365.Observability.Contracts.$(Agent365EtwSdkPackageVersion).nupkg"
      DestinationFolder="$(DistroPackageSourcePath)" />
    <Copy
      SourceFiles="$(PackageValidationArtifactsPath)Microsoft.Agents.A365.Observability.Etw.$(Agent365EtwSdkPackageVersion).nupkg;$(PackageValidationArtifactsPath)Microsoft.Agents.A365.Observability.Contracts.$(Agent365EtwSdkPackageVersion).nupkg"
      DestinationFolder="$(EtwPackageSourcePath)" />

    <WriteLinesToFile
      File="$(OutDir)package-validation-path.txt"
      Lines="$(PackageValidationArtifactsPath)"
      Overwrite="true" />
  </Target>
</Project>
