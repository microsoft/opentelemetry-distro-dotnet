<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- Defaults to the standalone SDK repo version; CI overrides it with the unique prerelease version
         that the locally packed artifacts were produced with (-p:SmokePackageVersion=...). -->
    <SmokePackageVersion Condition="'$(SmokePackageVersion)' == ''">$(Agent365EtwSdkPackageVersion)</SmokePackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.A365.Observability.Etw" Version="[$(SmokePackageVersion)]" />
  </ItemGroup>
</Project>
