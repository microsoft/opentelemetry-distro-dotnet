<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <EtwSdkSmokePackageVersion Condition="'$(EtwSdkSmokePackageVersion)' == ''">$(MicrosoftOpenTelemetryPackageVersion)</EtwSdkSmokePackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.OpenTelemetry.A365.Etw" Version="[$(EtwSdkSmokePackageVersion)]" />
  </ItemGroup>
</Project>
